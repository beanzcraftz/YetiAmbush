[Unit]
Description=YetiAmbush ADHD Hydration Daemon
Documentation=https://github.com/beanzcraftz/YetiAmbush
After=graphical-session.target sound.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/bin/yetiambush-daemon --daemon
Restart=always
RestartSec=5s
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
